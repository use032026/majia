<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 10+ uses scoped MediaStore; older devices fail closed until
         the embedding app has granted this compatibility permission. -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />

    <application>
        <!-- Shared owner for both Flutter `openWeb` and a Mini `/web` child.
             It carries no package/runtime state; Mini-only behaviour reaches
             it through a short-lived delegate registered by the runtime. -->
        <activity
            android:name=".web.OnlineWebActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:theme="@style/StminiFlutterTheme" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.stmini_flutter.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/stmini_share_paths" />
        </provider>
        <activity
            android:name=".ui.StminiContainerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:taskAffinity="${applicationId}.stmini_flutter"
            android:documentLaunchMode="intoExisting"
            android:alwaysRetainTaskState="true"
            android:excludeFromRecents="false"
            android:exported="false"
            android:theme="@style/StminiFlutterTheme" />
        <!-- A verified Home Mini is the host App's visible home surface. Keep
             it in the host task: tapping the launcher icon must resume this
             activity rather than the Flutter activity beneath it. -->
        <activity
            android:name=".ui.StminiHomeActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTop"
            android:excludeFromRecents="false"
            android:exported="false"
            android:theme="@style/StminiFlutterTheme" />
        <!-- Mini-owned /web and local child pages stay in the root Mini Task.
             Do not add documentLaunchMode or taskAffinity here. -->
        <activity
            android:name=".ui.StminiWebPageActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:exported="false"
            android:theme="@style/StminiFlutterTheme" />
    </application>
</manifest>
