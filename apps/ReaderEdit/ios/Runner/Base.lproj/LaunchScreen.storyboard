                            <constraint firstItem="launch-mark" firstAttribute="centerY" secondItem="launch-view" secondAttribute="centerY" constant="-28" id="mark-center-y"/>
                            <constraint firstItem="launch-name" firstAttribute="top" secondItem="launch-mark" secondAttribute="bottom" constant="18" id="name-top"/>
                            <constraint firstItem="launch-name" firstAttribute="centerX" secondItem="launch-view" secondAttribute="centerX" id="name-center-x"/>
