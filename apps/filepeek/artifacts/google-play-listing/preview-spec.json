{
  "schema_version": 2,
  "store": "google_play",
  "app_name": "FileRecheck",
  "qa_dir": "qa",
  "defaults": {
    "background_top": "#0D3F43",
    "background_bottom": "#006B6B",
    "text_color": "#FFFFFF",
    "muted_text_color": "#D8F2EE"
  },
  "items": [
    {
      "kind": "screenshot",
      "locale": "en-US",
      "source": "source/01-home-android.png",
      "output": "final/en-US/phone/01-home.png",
      "size": [
        1080,
        1920
      ],
      "headline": "Inspect Local Files"
    },
    {
      "kind": "screenshot",
      "locale": "en-US",
      "source": "source/02-json-android.png",
      "output": "final/en-US/phone/02-json.png",
      "size": [
        1080,
        1920
      ],
      "headline": "Validate JSON"
    },
    {
      "kind": "screenshot",
      "locale": "en-US",
      "source": "source/03-csv-android.png",
      "output": "final/en-US/phone/03-csv.png",
      "size": [
        1080,
        1920
      ],
      "headline": "Review CSV"
    },
    {
      "kind": "screenshot",
      "locale": "en-US",
      "source": "source/04-report-android.png",
      "output": "final/en-US/phone/04-report.png",
      "size": [
        1080,
        1920
      ],
      "headline": "Preview Reports"
    },
    {
      "kind": "screenshot",
      "locale": "zh-CN",
      "source": "source/zh-01-home-android.png",
      "output": "final/zh-CN/phone/01-home.png",
