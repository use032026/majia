        1080,
        1920
      ],
      "headline": "本机检查文件"
    },
    {
      "kind": "screenshot",
      "locale": "zh-CN",
      "source": "source/zh-02-json-android.png",
      "output": "final/zh-CN/phone/02-json.png",
      "size": [
        1080,
        1920
      ],
      "headline": "校验 JSON"
    },
    {
      "kind": "screenshot",
      "locale": "zh-CN",
      "source": "source/zh-03-csv-android.png",
      "output": "final/zh-CN/phone/03-csv.png",
      "size": [
        1080,
        1920
      ],
      "headline": "浏览 CSV 表格"
